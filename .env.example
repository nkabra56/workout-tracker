# Server-side only. Never commit real owner identities or credentials.
HOST=127.0.0.1
PORT=5173
DATA_DIR=./private-data
APP_ORIGIN=https://your-private-host.tailnet.ts.net
SYNC_AUTH=tailscale
TAILSCALE_PROXY_ADDRESS=127.0.0.1
# Exact login(s) from Tailscale status/admin, comma separated. Empty fails closed.
TAILSCALE_ALLOWED_LOGINS=
# Non-Serve compatibility API only: SYNC_AUTH=token and random >=32-character SYNC_TOKEN.
# No anonymous fallback. Never put server secrets in browser code.
